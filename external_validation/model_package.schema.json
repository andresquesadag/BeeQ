{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeeQ external-validation model package manifest",
  "type": "object",
  "required": [
    "package_schema_version", "model_version", "model_name", "artifact",
    "artifact_sha256", "feature_order", "feature_schema_sha256",
    "preprocessing", "threshold_policy", "endpoint", "baseline_provenance",
    "approval_status"
  ],
  "properties": {
    "package_schema_version": {"const": 1},
    "model_version": {"type": "string", "minLength": 1},
    "model_name": {"type": "string", "minLength": 1},
    "artifact": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_order": {"type": "array", "minItems": 10, "maxItems": 10},
    "feature_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preprocessing": {"type": "object"},
    "threshold_policy": {"type": "object"},
    "endpoint": {"type": "object"},
    "baseline_provenance": {"type": "object"},
    "approval_status": {"const": "approved_for_external_validation"}
  },
  "additionalProperties": true
}
